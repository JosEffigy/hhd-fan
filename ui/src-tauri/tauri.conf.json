{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hhd-fan-ui",
  "version": "0.1.0",
  "identifier": "io.github.joseffigy.hhdfanui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run web-build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Fan Control",
      "width": 550,
      "height": 750,
      "transparent": true,
      "decorations": true,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "System",
    "shortDescription": "Fan control overlay",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1"]
      }
    }
  }
}
